{
  "_ui": {
    "version": 1,
    "state": { "mood": "quiet", "songs": 0 }
  },
  "type": "Scene",
  "anchor": "code",
  "environment": { "lighting": "auto", "shadows": true },
  "actors": [
    {
      "id": "bush",
      "name": "Singing Bush",
      "transform": { "position": [0, 0, 0], "scale": 1 },
      "body": {
        "model": "https://raw.githubusercontent.com/KhronosGroup/glTF-Sample-Assets/main/Models/BoxAnimated/glTF-Binary/BoxAnimated.glb",
        "scale": 0.15,
        "animations": {
          "idle": { "clip": 0, "loop": true, "speed": 0.25 },
          "sing": { "clip": 0, "loop": true, "speed": 1.5 }
        },
        "sounds": {
          "song": { "url": "https://raw.githubusercontent.com/bclnet/JsonScene/master/assets/sounds/singing-bush.wav", "spatial": true }
        }
      },
      "mind": {
        "persona": "You are the Singing Bush from The Three Amigos: a shrub in the desert that answers riddles with songs and speaks in cryptic rhymes. You never move.",
        "senses": ["userDistance", "timeOfDay", "lastEvent"],
        "tools": ["say", "play", "sound"],
        "budget": { "tokens": 20000, "perTurn": 300, "cooldown": 8 },
        "triggers": ["tap", "spoken"],
        "canned": [
          { "match": "^tap", "do": [ { "say": "Ask, and the bush shall sing." }, { "play": "sing" }, { "sound": "song" } ] },
          { "match": "sing|song", "do": [ { "play": "sing" }, { "sound": "song" } ] },
          { "match": "who|what are you", "do": { "say": "I am the singing bush. Some say I am a shrub." } }
        ]
      },
      "on": {
        "appear": { "play": "idle" },
        "soundEnd": [ { "play": "idle" }, { "set": { "mood": "quiet", "songs": "${state.songs + 1}" } } ],
        "tap": { "set": { "mood": "singing" } }
      }
    }
  ]
}
