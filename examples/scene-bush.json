{
  "_ui": {
    "version": 1,
    "state": { "mood": "quiet", "songs": 0 },
    "fragments": {
      "song": { "url": "https://raw.githubusercontent.com/bclnet/JsonScene/master/assets/sounds/singing-bush.wav", "spatial": true }
    }
  },
  "type": "Scene",
  "anchor": "code",
  "environment": { "lighting": "auto", "shadows": true },
  "actors": [
    {
      "id": "bush",
      "name": "Singing Bush",
      "transform": { "position": [0, 0, 0], "scale": 1 },
      "body": { "$ref": "bodies/box.json", "sounds": { "song": { "$ref": "#song" } } },
      "mind": { "$ref": "minds/singing-bush.json" },
      "on": {
        "appear": { "play": "idle" },
        "soundEnd": [ { "play": "idle" }, { "set": { "mood": "quiet", "songs": "${state.songs + 1}" } } ],
        "tap": { "set": { "mood": "singing" } }
      }
    }
  ]
}
